{
    "name": "netresearch/nr-scheduler",
    "type": "typo3-cms-extension",
    "description": "Extends the TYPO3 scheduler extension with some functions.",
    "license": [
        "GPL-3.0-or-later"
    ],
    "keywords": [
        "TYPO3",
        "extension",
        "scheduler"
    ],
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "rico.sonntag@netresearch.de",
            "role": "Developer",
            "homepage": "https://www.netresearch.de/"
        }
    ],
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "audit": {
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "Upstream firebase/php-jwt issue via typo3/cms-core, no fix available yet"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3",
        "typo3/cms-scheduler": "^13.4 || ^14.3"
    },
    "require-dev": {
        "a9f/typo3-fractor": "^0.5 || ^1.0",
        "friendsofphp/php-cs-fixer": "^3.65",
        "overtrue/phplint": "^9.5",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^1.0 || ^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.0 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.0 || ^2.0",
        "phpstan/phpstan-strict-rules": "^1.0 || ^2.0",
        "saschaegerer/phpstan-typo3": "^1.0 || ^3.0",
        "ssch/typo3-rector": "^2.0 || ^3.0",
        "typo3/testing-framework": "^9.2"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "nr_scheduler",
            "web-dir": ".build/public"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\NrScheduler\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\NrScheduler\\Tests\\": "Tests"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config Build/.php-cs-fixer.dist.php --diff --verbose --cache-file .build/.php-cs-fixer.cache"
        ],
        "ci:rector": [
            "rector process --config Build/rector.php"
        ],
        "ci:fractor": [
            "fractor process --config Build/fractor.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:lint": [
            "phplint --configuration Build/.phplint.yml"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration Build/phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:phpstan:baseline": [
            "phpstan analyze --configuration Build/phpstan.neon --memory-limit=-1 --generate-baseline Build/phpstan-baseline.neon --allow-empty-baseline"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:fractor": [
            "@ci:fractor --dry-run"
        ],
        "ci:test:php:unit": [
            "phpunit --configuration Build/UnitTests.xml"
        ],
        "ci:test:php:unit:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --configuration Build/UnitTests.xml --coverage-html .build/coverage/"
        ],
        "ci:test:php:functional": [
            "phpunit --configuration Build/FunctionalTests.xml"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:fractor",
            "@ci:test:php:unit",
            "@ci:test:php:functional",
            "@ci:test:php:cgl"
        ]
    }
}
